{
  "name": "kotik-researcher",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic AI system to assist in research tasks",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:visual",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test --project=e2e",
    "test:e2e:quick": "E2E_RENDERER_URL=http://localhost:5173 playwright test --project=e2e",
    "test:visual": "pnpm build && playwright test --project=visual",
    "test:agent:electron": "node scripts/test-agent-electron.mjs",
    "test:agent:dev": "node scripts/test-agent-dev.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}

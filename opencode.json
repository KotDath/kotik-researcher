{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": ["AGENTS.md"],
  "subagent_depth": 4,
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "exec",
        "playwright-mcp",
        "--cdp-endpoint",
        "http://127.0.0.1:9222",
        "--output-dir",
        "/tmp/opencode"
      ]
    }
  }
}

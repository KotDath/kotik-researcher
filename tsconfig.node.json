{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "composite": true
  },
  "include": [
    "electron.vite.config.ts",
    "vite.renderer.config.ts",
    "vitest.workspace.ts",
    "playwright.config.ts",
    "src/main",
    "src/preload",
    "src/shared",
    "tests/e2e",
    "tests/visual",
    "tests/unit/**/*.test.ts"
  ]
}
